# Auth0 Configuration
AUTH0_DOMAIN=middle-earth.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://palantir.middle-earth.local

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Drive Folder IDs (from your Drive URLs)
GDRIVE_SHIRE_FOLDER_ID=your_shire_folder_id
GDRIVE_MORDOR_FOLDER_ID=your_mordor_folder_id
GDRIVE_SHARED_FOLDER_ID=your_shared_folder_id

# Server
SERVER_PORT=3000
SERVER_HOST=localhost
